# ============================================================
**/bin/
**/obj/
.vs/

# ============================================================
# IDE ve işletim sistemi
# ============================================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ============================================================
# Çalışma zamanında üretilen / yeniden üretilebilir veriler
# ============================================================
pipeline_output/
output/debug_vlm/
output/debug_rag/
output/*.avi
debug_vlm/
debug_rag/
*.log
LLM/reports/runtime/
LLM/llm_crash.log
data/databases/*.db
yuklemeler/

# ============================================================
# Test videoları (referans veri değil — VRAG referans görselleri
# 'veriler/' altında ayrı ve Git LFS ile takip ediliyor, bkz. .gitattributes)
# ============================================================
data/videos/*.mp4
data/videos/*.avi
data/videos/*.mkv
VİDEOLAR/

# ============================================================
# Geçici / ajan klasörleri
# ============================================================
.agents/

# ============================================================
# Ubuntu/vLLM geçişiyle eklenenler
# ============================================================
# Test videoları — main yalnız mp4/avi/mkv'yi eliyordu, .webm sızıyordu
data/videos/

# Çalışma zamanı SQLite (migration'lardan üretilir)
LLM/data/databases/*.db

# vLLM'in AYRI sanal ortamı (~7.7 GB) — .venv/ deseni zaten yakalar,
# açıklık olsun diye yazıldı
vllm_servis/.venv/

# Gizli bilgi — .env.example commit edilir, .env ASLA
.env
*.env
!.env.example
!*.env.example

# Kazara oluşmuş klasör: bir komut '> /dev/null' yerine '> dev/null'
# yazdığı için git-lfs hook'ları buraya düşmüş. Gerçek hook'lar .git/hooks'ta.
dev/null/
